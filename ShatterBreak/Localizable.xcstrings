    "directCaptureNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS asks you to confirm direct screen capture when a work session starts, and again about once a month."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "macOS запрашивает подтверждение на прямой захват экрана при начале рабочей сессии, а затем повторно — примерно раз в месяц."
          }
        }
      }
    },
    "directCaptureWarningText" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shatter also needs macOS’s confirmation to capture the screen directly. Until it is allowed, breaks use the Fogged effect instead."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Для эффекта «Стекло» также требуется подтверждение macOS на прямой захват экрана. Пока оно не получено, для перерывов используется эффект «Туман»."
          }
        }
      }
    },
    "earlyReturnLeadExceedsRestWarning" : {
