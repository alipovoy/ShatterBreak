    "permissionWarningText" : {
      "comment" : "Inline warning shown when Screen Recording permission is missing.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shatter requires Screen Recording permission. Without it, breaks use the Fogged effect instead. If ShatterBreak is already switched on in System Settings, the entry is stale, for example after an update: remove it with the “−” button and add the app back with the “+” button."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Для эффекта «Стекло» требуется разрешение на запись экрана. Без него в перерывах используется эффект «Туман». Если ShatterBreak уже включён в Системных настройках, эта запись может быть устаревшей, например после обновления: удалите её кнопкой «−» и добавьте приложение снова кнопкой «+»."
          }
        }
      }
    },
    "playSoundToggle" : {
      "comment" : "Plays a sound when a break starts.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
