    "autoStartOnLaunchHelp" : {
      "comment" : "A focus session starts by itself when the app launches.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, a focus session starts automatically each time ShatterBreak launches."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Если этот параметр включён, фокус-сессия запускается автоматически при каждом запуске ShatterBreak."
          }
        }
      }
    },
    "autoStartOnLaunchToggle" : {
