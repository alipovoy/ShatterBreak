    "allowEarlyReturnHelp" : {
      "comment" : "The “I’m back” button lets the user end a break before it runs out.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show the “I’m back” button before a break ends so you can return early."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Показывать кнопку «Я на месте» перед завершением перерыва, чтобы можно было вернуться раньше."
          }
        }
      }
    },
    "allowEarlyReturnToggle" : {
      "comment" : "Shows the early “I’m back” button during a break.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
