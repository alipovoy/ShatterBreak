    "countSessionEarlyHelp" : {
      "comment" : "A work session counts as worked a little before it ends, so leaving in its closing minutes still counts it.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Count a work session as worked shortly before it ends, so stepping away in its closing minutes still counts it."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Засчитывать рабочую сессию как отработанную незадолго до её завершения, чтобы сессия засчитывалась, даже если вы отошли от компьютера в последние минуты."
          }
        }
      }
    },
    "countSessionEarlyToggle" : {
      "comment" : "A work session counts shortly before it ends.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Count Sessions Early"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Засчитывать сессии досрочно"
