#!/bin/sh
#
# Commit-msg hook: reject commit subjects that are not Conventional Commits.
#
# Enable it once per clone with:
#   git config core.hooksPath .githooks
#
# Commits made with --no-verify or from a clone without the hook are still
# caught by the PR Conventions workflow.

"$(git rev-parse --show-toplevel)/Scripts/lint-commit-subject.sh" --git-workflow --file "$1" >/dev/null
